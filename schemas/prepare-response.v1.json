{
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "response": {
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "response"
      ],
      "title": "Category",
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "minLength": 1,
          "title": "Category Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "category_id"
      ],
      "title": "Example",
      "type": "object"
    },
    "PrepareDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "max_text_tokens_approx": {
          "title": "Max Text Tokens Approx",
          "type": "integer"
        },
        "n_ctx": {
          "title": "N Ctx",
          "type": "integer"
        },
        "n_prompt_tokens_without_text": {
          "title": "N Prompt Tokens Without Text",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Warning_"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "n_prompt_tokens_without_text",
        "n_ctx",
        "max_text_tokens_approx",
        "warnings"
      ],
      "title": "PrepareDiagnostics",
      "type": "object"
    },
    "PreparedCategory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "response": {
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "token_id": {
          "title": "Token Id",
          "type": "integer"
        },
        "token_piece": {
          "title": "Token Piece",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "response",
        "token_id",
        "token_piece"
      ],
      "title": "PreparedCategory",
      "type": "object"
    },
    "PreparedTask": {
      "additionalProperties": false,
      "properties": {
        "boundary_policy": {
          "title": "Boundary Policy",
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/PreparedCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "engine_fingerprint": {
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "prepared_hash": {
          "title": "Prepared Hash",
          "type": "string"
        },
        "prepared_schema_version": {
          "const": 1,
          "title": "Prepared Schema Version",
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/TemplateProfileRef"
        },
        "tail_tokens": {
          "items": {
            "type": "integer"
          },
          "title": "Tail Tokens",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "task_hash": {
          "title": "Task Hash",
          "type": "string"
        }
      },
      "required": [
        "prepared_schema_version",
        "task",
        "task_hash",
        "engine_fingerprint",
        "profile",
        "boundary_policy",
        "tail_tokens",
        "categories",
        "prepared_hash"
      ],
      "title": "PreparedTask",
      "type": "object"
    },
    "Preview": {
      "additionalProperties": false,
      "properties": {
        "n_prompt_tokens": {
          "title": "N Prompt Tokens",
          "type": "integer"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "n_prompt_tokens"
      ],
      "title": "Preview",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "minItems": 2,
          "title": "Categories",
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "title": "Examples",
          "type": "array"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name",
        "instructions",
        "categories"
      ],
      "title": "Task",
      "type": "object"
    },
    "TemplateProfileRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "template_sha256": {
          "title": "Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "template_sha256"
      ],
      "title": "TemplateProfileRef",
      "type": "object"
    },
    "Warning_": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning_",
      "type": "object"
    }
  },
  "$id": "https://llikert.invalid/schemas/prepare-response.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "$ref": "#/$defs/PrepareDiagnostics"
    },
    "prepared": {
      "$ref": "#/$defs/PreparedTask"
    },
    "preview": {
      "additionalProperties": {
        "$ref": "#/$defs/Preview"
      },
      "propertyNames": {
        "enum": [
          "example",
          "text"
        ]
      },
      "title": "Preview",
      "type": "object"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "prepared",
    "diagnostics",
    "preview"
  ],
  "title": "PrepareResponse",
  "type": "object"
}
