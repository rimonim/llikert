{
  "$id": "https://llikert.invalid/schemas/prepare-request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "preview_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Text"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "task": {
      "additionalProperties": true,
      "title": "Task",
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "task"
  ],
  "title": "PrepareRequest",
  "type": "object"
}
