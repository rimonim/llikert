{
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "response": {
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "response"
      ],
      "title": "Category",
      "type": "object"
    },
    "ClientInfo": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "python",
            "r"
          ],
          "title": "Language",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "language",
        "package",
        "version"
      ],
      "title": "ClientInfo",
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "minLength": 1,
          "title": "Category Id",
          "type": "string"
        },
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        }
      },
      "required": [
        "item",
        "category_id"
      ],
      "title": "Example",
      "type": "object"
    },
    "PreparedCategory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "response": {
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "token_id": {
          "title": "Token Id",
          "type": "integer"
        },
        "token_piece": {
          "title": "Token Piece",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "response",
        "token_id",
        "token_piece"
      ],
      "title": "PreparedCategory",
      "type": "object"
    },
    "PreparedTask": {
      "additionalProperties": false,
      "properties": {
        "boundary_policy": {
          "title": "Boundary Policy",
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/PreparedCategory"
          },
          "title": "Categories",
          "type": "array"
        },
        "engine_fingerprint": {
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "prepared_hash": {
          "title": "Prepared Hash",
          "type": "string"
        },
        "prepared_schema_version": {
          "const": 1,
          "title": "Prepared Schema Version",
          "type": "integer"
        },
        "profile": {
          "$ref": "#/$defs/TemplateProfileRef"
        },
        "tail_tokens": {
          "items": {
            "type": "integer"
          },
          "title": "Tail Tokens",
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "task_hash": {
          "title": "Task Hash",
          "type": "string"
        }
      },
      "required": [
        "prepared_schema_version",
        "task",
        "task_hash",
        "engine_fingerprint",
        "profile",
        "boundary_policy",
        "tail_tokens",
        "categories",
        "prepared_hash"
      ],
      "title": "PreparedTask",
      "type": "object"
    },
    "PromptFormat": {
      "additionalProperties": false,
      "description": "Templates for turning the task and one item into chat messages (docs/prompts.md).",
      "properties": {
        "answer_instruction": {
          "default": "Answer with exactly one of the response codes listed above and nothing else.",
          "title": "Answer Instruction",
          "type": "string"
        },
        "code": {
          "default": "{response} = {label}",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "code_separator": {
          "default": "\n",
          "title": "Code Separator",
          "type": "string"
        },
        "scale": {
          "default": "Response codes:\n{codes}",
          "title": "Scale",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "{instructions}\n\n{scale}\n\n{answer_instruction}",
          "title": "System"
        },
        "user": {
          "default": "Text:\n<text>\n{item}\n</text>",
          "title": "User",
          "type": "string"
        }
      },
      "title": "PromptFormat",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "minItems": 2,
          "title": "Categories",
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/Example"
          },
          "title": "Examples",
          "type": "array"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        },
        "prompt": {
          "$ref": "#/$defs/PromptFormat"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "name",
        "instructions",
        "categories"
      ],
      "title": "Task",
      "type": "object"
    },
    "TemplateProfileRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "template_sha256": {
          "title": "Template Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "template_sha256"
      ],
      "title": "TemplateProfileRef",
      "type": "object"
    }
  },
  "$id": "https://llikert.invalid/schemas/checkpoint-manifest.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_schema_version": {
      "const": 1,
      "title": "Checkpoint Schema Version",
      "type": "integer"
    },
    "client": {
      "$ref": "#/$defs/ClientInfo"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "engine": {
      "additionalProperties": true,
      "title": "Engine",
      "type": "object"
    },
    "engine_fingerprint": {
      "title": "Engine Fingerprint",
      "type": "string"
    },
    "execution": {
      "additionalProperties": true,
      "title": "Execution",
      "type": "object"
    },
    "ids": {
      "items": {
        "type": "string"
      },
      "title": "Ids",
      "type": "array"
    },
    "prepared": {
      "$ref": "#/$defs/PreparedTask"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "text_sha256": {
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Text Sha256",
      "type": "array"
    }
  },
  "required": [
    "checkpoint_schema_version",
    "created_at",
    "client",
    "protocol_version",
    "engine_fingerprint",
    "engine",
    "execution",
    "prepared",
    "ids",
    "text_sha256"
  ],
  "title": "CheckpointManifest",
  "type": "object"
}
