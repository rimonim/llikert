{
  "$defs": {
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "response": {
          "minLength": 1,
          "title": "Response",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "response"
      ],
      "title": "Category",
      "type": "object"
    },
    "Example": {
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "minLength": 1,
          "title": "Category Id",
          "type": "string"
        },
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        }
      },
      "required": [
        "item",
        "category_id"
      ],
      "title": "Example",
      "type": "object"
    },
    "PromptFormat": {
      "additionalProperties": false,
      "description": "Templates for turning the task and one item into chat messages (docs/prompts.md).",
      "properties": {
        "code": {
          "default": "{response} = {label}",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "code_separator": {
          "default": "\n",
          "title": "Code Separator",
          "type": "string"
        },
        "scale": {
          "default": "Response codes:\n{codes}",
          "title": "Scale",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "{instructions}\n\n{scale}",
          "title": "System"
        },
        "user": {
          "default": "Text:\n<text>\n{item}\n</text>\n\n{answer_instruction}",
          "title": "User",
          "type": "string"
        }
      },
      "title": "PromptFormat",
      "type": "object"
    }
  },
  "$id": "https://llikert.invalid/schemas/task.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer_instruction": {
      "default": "Answer with exactly one of the response codes listed above and nothing else.",
      "title": "Answer Instruction",
      "type": "string"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "minItems": 2,
      "title": "Categories",
      "type": "array"
    },
    "examples": {
      "items": {
        "$ref": "#/$defs/Example"
      },
      "title": "Examples",
      "type": "array"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "ordered": {
      "default": false,
      "title": "Ordered",
      "type": "boolean"
    },
    "prompt": {
      "$ref": "#/$defs/PromptFormat"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "name",
    "instructions",
    "categories"
  ],
  "title": "Task",
  "type": "object"
}
