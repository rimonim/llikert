# Optional settings for deploy/service.sh. Copy to deploy/llikert.env and edit.
# Every line is a default; delete the ones you don't change.

# LLIKERT_MODELS_DIR=/path/to/models          # folder holding the model file (default: ./models)
# LLIKERT_MODEL_FILE=qwen3-4b-instruct-2507-f32.gguf
# LLIKERT_MODEL_SHA256=a5733d5a25e8b824e1ef9d7e75449ffd8f8ec582de8ac253420e4423a7f0e357
# LLIKERT_KEY_FILE=/path/to/llikert-access-key.txt   # default: ./llikert-access-key.txt
# LLIKERT_PORT=8080
# LLIKERT_BIND=127.0.0.1                      # 0.0.0.0 only behind an HTTPS reverse proxy
# LLIKERT_N_CTX=4096                          # longest prompt in tokens; changes the setup
# LLIKERT_IMAGE=llikert-service:0.1.0.dev0-cuda12.9
# LLIKERT_CONTAINER=llikert                   # container name, if you run more than one
